#: assets/admin/settings.js:1
#: assets/admin/wizard.js:1
#: src/js/admin/registry/premiumSurface.js:28
msgid "Send purchases and page data from your server to GA4, Meta CAPI and Google Ads instead of depending on the browser. Webhooks fire from the order itself, with per-site measurement IDs for shared server containers."
msgstr ""

#: assets/admin/settings.js:1
#: assets/admin/wizard.js:1
#: src/js/admin/registry/premiumSurface.js:32
msgid "Safari caps the lifetime of any cookie set by JavaScript at 7 days, and at 24 hours when the visitor arrives from an ad click. Cookies set by your own server over HTTP are not capped."
msgstr ""

#: assets/admin/settings.js:1
#: assets/admin/wizard.js:1
#: src/js/admin/registry/premiumSurface.js:37
msgid "See how server-side tracking works"
msgstr ""

#: assets/admin/settings.js:1
#: assets/admin/wizard.js:1
#: src/js/admin/registry/premiumSurface.js:43
msgid "Purchase accuracy"
msgstr ""

#: assets/admin/settings.js:1
#: assets/admin/wizard.js:1
#: src/js/admin/registry/premiumSurface.js:44
msgid "A payment gateway that redirects the customer away from your thank-you page never fires the browser 'purchase' event, so the sale goes unrecorded. Sending it from the server recovers it. A stable event ID keeps Meta, TikTok and other Conversions API destinations from counting a recovered purchase twice, refunds and order-status changes are sent as their own events, and order attribution is surfaced where you can act on it."
msgstr ""

#: assets/admin/settings.js:1
#: assets/admin/wizard.js:1
#: src/js/admin/registry/premiumSurface.js:48
msgid "Send the purchase to GA4 from one side only. GA4 does not reconcile a purchase that arrives from both the browser and the server, so delivering it from both double counts the revenue."
msgstr ""

#: assets/admin/settings.js:1
#: assets/admin/wizard.js:1
#: src/js/admin/registry/premiumSurface.js:53
msgid "See how purchase accuracy works"
msgstr ""

#: assets/admin/settings.js:1
#: assets/admin/wizard.js:1
#: src/js/admin/registry/premiumSurface.js:59
msgid "Consent-safe measurement"
msgstr ""

#: assets/admin/settings.js:1
#: assets/admin/wizard.js:1
#: src/js/admin/registry/premiumSurface.js:60
msgid "Events that occur before the visitor answers the banner are queued and replayed once consent is granted, rather than discarded. Webhooks are consent-gated server-side, and the WP Consent API is wired up for you."
msgstr ""

#: assets/admin/settings.js:1
#: assets/admin/wizard.js:1
#: src/js/admin/registry/premiumSurface.js:64
msgid "Google Consent Mode requires the consent default to run before the container loads. When it does not, tags can initialise and fire with no consent instruction at all."
msgstr ""

#: assets/admin/settings.js:1
#: assets/admin/wizard.js:1
#: src/js/admin/registry/premiumSurface.js:69
